{
  "name": "resume",
  "private": true,
  "description": "yzjacc's resume",
  "scripts": {
    "start": "npm run dev",
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/build.mjs",
    "build:web": "node scripts/build.mjs --web-only",
    "watch": "node scripts/watch.mjs",
    "pdf": "npm run build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run typecheck && npm test",
    "deploy": "node scripts/deploy.mjs",
    "deploy:dry-run": "node scripts/deploy.mjs --dry-run",
    "format": "prettier --write --ignore-unknown src scripts tests vite.config.ts",
    "verify:live": "node scripts/verify-live.mjs"
  },
  "repository": {
    "type": "git"
  },
  "author": "Jackie Yu",
  "license": "cc-by-sa-4.0",
  "homepage": "https://yuzijun.cn",
  "devDependencies": {
    "@alicloud/pop-core": "^1.8.0",
    "@types/ejs": "^3.1.5",
    "@types/node": "^22.0.0",
    "chokidar": "^4.0.3",
    "dotenv": "^17.2.3",
    "ejs": "^3.1.10",
    "less": "^4.1.3",
    "prettier": "2.8.2",
    "puppeteer": "^25.11.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6"
  },
  "dependencies": {
    "ali-oss": "^6.23.0"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  }
}

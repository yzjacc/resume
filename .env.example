OSS_REGION=oss-cn-beijing
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
# Configure actual accelerated domains; needs cdn:RefreshObjectCaches permission.
CDN_DOMAINS=https://yuzijun.cn,https://www.yuzijun.cn
# Optional: use an existing Chrome instead of Puppeteer's downloaded browser.
# PUPPETEER_EXECUTABLE_PATH=/path/to/chrome
# Only for CI/container environments that cannot run the browser sandbox:
# PUPPETEER_NO_SANDBOX=true
